{
  "name": "02 - PR Context Collector",
  "nodes": [
    {
      "parameters": {},
      "id": "pr-context-trigger",
      "name": "Child Workflow Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst maxPages = Number($env.GITHUB_FILES_MAX_PAGES || 5);\nreturn Array.from({ length: maxPages }, (_, i) => ({ json: { ...input, page: i + 1, per_page: 100 } }));"
      },
      "id": "build-github-file-requests",
      "name": "Build GitHub File Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.repository}}/pulls/{{$json.pull_request_number}}/files?per_page={{$json.per_page}}&page={{$json.page}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.GITHUB_TOKEN}}" },
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" },
            { "name": "User-Agent", "value": "n8n-enterprise-ai-code-review" }
          ]
        },
        "options": {
          "response": { "response": { "responseFormat": "json" } },
          "timeout": 30000
        }
      },
      "id": "get-changed-files",
      "name": "Get Changed Files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "continueOnFail": true
    }]
}